# Canteiro OS — vitrine de demonstração
#
# ⚠️ LEI DE DADOS: o nome real do cliente NUNCA entra no repositório.
# Ele vive só nas variáveis de ambiente da Vercel, no ambiente da demo.
# Sem estas variáveis, a vitrine usa o nome de fantasia do seed.

NEXT_PUBLIC_TENANT_NAME="Construtora Araguaia Obras"
NEXT_PUBLIC_TENANT_CITY="Vale do Araguaia"

# Data de referência da demonstração (ISO). Todo o seed é calculado a partir
# dela, para que "aprovada há 18 dias" continue verdadeiro em qualquer dia.
NEXT_PUBLIC_DEMO_DATE="2026-08-21"
